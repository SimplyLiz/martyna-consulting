---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Honorar & Preise"
  ogTitle="Transparente Honorare für AI-Compliance-Beratung"
  description="Stundensatz, Projektpreise und Retainer für EU AI Act, DSGVO und KI-Governance Beratung in Wien. Erstgespräch kostenlos."
>

  <section class="page-hero">
    <div class="container">
      <span class="section-label">Honorar</span>
      <span class="gold-rule"></span>
      <h1>Transparente<br /><em>Preise</em></h1>
      <p class="hero-sub">
        Klare Honorare ohne versteckte Kosten — damit Sie wissen, womit Sie rechnen.
        Je nach Umfang arbeite ich auf Stundenbasis, als Festpreisprojekt oder
        im monatlichen Retainer.
      </p>
    </div>
  </section>

  <div class="divider"></div>

  <!-- Stundensatz + Einstieg -->
  <section class="section">
    <div class="container">
      <div class="top-cards">

        <div class="top-card top-card--highlight">
          <span class="top-card-label">Erstgespräch</span>
          <span class="top-card-price">Kostenlos</span>
          <p>
            30 Minuten, unverbindlich per Videocall. Erste Einschätzung Ihrer
            Risikoklasse und des konkreten Handlungsbedarfs — ohne Verpflichtung.
          </p>
          <a href="/termin" class="btn btn-primary" style="margin-top:1.5rem;">Termin vereinbaren</a>
        </div>

        <div class="top-card">
          <span class="top-card-label">Stundenberatung</span>
          <span class="top-card-price">ab 150 <span class="top-card-unit">€/h</span></span>
          <p>
            Für punktuelle Fragen, Dokumenten-Reviews und projektbegleitende
            Mandate. Abrechnung im 30-Minuten-Takt; geschätzter Aufwand wird
            vor Beginn kommuniziert.
          </p>
        </div>

        <div class="top-card">
          <span class="top-card-label">Monatlicher Retainer</span>
          <span class="top-card-price">800 – 1.600 <span class="top-card-unit">€/Mo.</span></span>
          <p>
            4 – 8 Stunden laufende Begleitung: regulatorisches Monitoring,
            Ad-hoc-Fragen, Dokumentenpflege. Planbare Kosten, fester
            Ansprechpartner.
          </p>
        </div>

      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- Projektpreise -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-label">Projekte</span>
        <span class="gold-rule"></span>
        <h2>Typische Projektpreise</h2>
        <p class="section-sub">
          Festpreisangebote werden nach dem Erstgespräch erstellt — der genaue
          Aufwand hängt von der Komplexität Ihrer KI-Systeme und dem vorhandenen
          Dokumentationsstand ab.
        </p>
      </div>

      <div class="project-table">

        <div class="project-row project-row--header">
          <span>Leistung</span>
          <span>Typischer Aufwand</span>
          <span>Honorar</span>
        </div>

        <div class="project-row">
          <div class="project-name">
            <strong>Gap-Analyse &amp; Report</strong>
            <span>Bestandsaufnahme + strukturierter Handlungsbericht</span>
          </div>
          <span class="project-effort">1 – 2 Tage</span>
          <span class="project-price">1.200 – 2.400 €</span>
        </div>

        <div class="project-row">
          <div class="project-name">
            <strong>EU AI Act Risikoklassifizierung</strong>
            <span>Einordnung in die 4 Risikoklassen nach Annex III</span>
          </div>
          <span class="project-effort">½ – 1 Tag</span>
          <span class="project-price">750 – 1.500 €</span>
        </div>

        <div class="project-row">
          <div class="project-name">
            <strong>Technische Dokumentation (Annex IV)</strong>
            <span>Vollständige Dokumentation für Hochrisiko-KI-Systeme</span>
          </div>
          <span class="project-effort">2 – 5 Tage</span>
          <span class="project-price">2.400 – 7.500 €</span>
        </div>

        <div class="project-row">
          <div class="project-name">
            <strong>Datenschutz-Folgenabschätzung (DPIA)</strong>
            <span>Risikoanalyse nach Art. 35 DSGVO für KI-Prozesse</span>
          </div>
          <span class="project-effort">1 – 2 Tage</span>
          <span class="project-price">1.500 – 3.000 €</span>
        </div>

        <div class="project-row">
          <div class="project-name">
            <strong>Interne KI-Nutzungsrichtlinie</strong>
            <span>Maßgeschneiderte Policy für den Mitarbeitereinsatz von KI-Tools</span>
          </div>
          <span class="project-effort">1 – 2 Tage</span>
          <span class="project-price">1.200 – 2.400 €</span>
        </div>

      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- Workshops -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-label">Schulungen</span>
        <span class="gold-rule"></span>
        <h2>Workshops &amp; Briefings</h2>
      </div>

      <div class="workshop-grid">

        <div class="workshop-card">
          <div class="workshop-head">
            <h3>Geschäftsführer-Briefing</h3>
            <span class="workshop-price">500 €</span>
          </div>
          <span class="workshop-meta">90 Minuten · Remote oder vor Ort · Pauschalhonorar</span>
          <p>
            Kompaktes Briefing zur persönlichen Haftungssituation nach § 43 GmbHG,
            den Pflichten aus dem EU AI Act und konkreten Delegationsempfehlungen.
            Ideal als Vorbereitung auf Aufsichtsrats- oder Gesellschaftersitzungen.
          </p>
        </div>

        <div class="workshop-card">
          <div class="workshop-head">
            <h3>EU AI Act Intensiv-Workshop</h3>
            <span class="workshop-price">2.000 – 3.500 €</span>
          </div>
          <span class="workshop-meta">Ganztags · bis 10 Personen · inkl. Unterlagen</span>
          <p>
            Halbtags- oder Ganztags-Workshop für Führungskräfte und Compliance-Teams.
            Vermittlung der wesentlichen Anforderungen, Zeitpläne und konkreter
            Handlungsschritte — ohne juristische Vorbildung.
          </p>
        </div>

        <div class="workshop-card">
          <div class="workshop-head">
            <h3>DSGVO für Entwicklungsteams</h3>
            <span class="workshop-price">auf Anfrage</span>
          </div>
          <span class="workshop-meta">Halbtags · bis 15 Personen · inkl. Unterlagen</span>
          <p>
            Praxisnahes Training für Software-Entwickler: Datenschutz im
            Entwicklungsprozess, Privacy by Design, DSGVO meets DevOps.
            Maßgeschneidert auf Ihre Tech-Stack und Arbeitsweise.
          </p>
        </div>

      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- FAQ -->
  <section class="section">
    <div class="container faq-layout">
      <div class="faq-sidebar">
        <span class="section-label">FAQ</span>
        <span class="gold-rule"></span>
        <h2>Häufige<br />Fragen</h2>
      </div>
      <div class="faq-items">

        <details class="faq-item">
          <summary>Wie kommt ein Festpreis zustande?</summary>
          <p>
            Nach dem kostenlosen Erstgespräch erhalten Sie ein schriftliches Angebot
            mit Leistungsumfang und Fixpreis. Änderungen am Umfang werden vorab
            besprochen — keine Überraschungen auf der Rechnung.
          </p>
        </details>

        <details class="faq-item">
          <summary>Bin ich als kleines Unternehmen überhaupt betroffen?</summary>
          <p>
            Ja. Der EU AI Act gilt für alle Unternehmen, die KI-Systeme in der EU
            einsetzen — unabhängig von der Unternehmensgröße. Kleinunternehmen
            haben bei manchen Pflichten vereinfachte Anforderungen, aber keine
            vollständige Ausnahme. Beim Erstgespräch kläre ich, was konkret auf
            Sie zutrifft.
          </p>
        </details>

        <details class="faq-item">
          <summary>Ist das Rechtsberatung?</summary>
          <p>
            Nein. Claritas AI Consulting erbringt regulatorisches und
            compliance-orientiertes Consulting — keine Rechtsberatung im Sinne
            der österreichischen Rechtsanwaltsordnung (RAO). Für anwaltliche
            Vertretung vermittle ich gerne qualifizierte Kanzleien mit
            KI-Schwerpunkt.
          </p>
        </details>

        <details class="faq-item">
          <summary>Arbeiten Sie auch remote / außerhalb Wiens?</summary>
          <p>
            Ja. Die meisten Projekte werden remote abgewickelt. Workshops und
            Vor-Ort-Termine sind österreichweit und im DACH-Raum möglich;
            Reisekosten werden nach Aufwand verrechnet.
          </p>
        </details>

        <details class="faq-item">
          <summary>Was sind die Zahlungskonditionen?</summary>
          <p>
            Rechnungen mit 14 Tagen Zahlungsziel. Bei größeren Projekten
            (ab ca. 2.000 €) ist eine Anzahlung von 30 % bei Auftragserteilung
            üblich. Alle Preise netto zzgl. gesetzlicher MwSt.
          </p>
        </details>

      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-banner">
    <div class="container cta-inner">
      <div class="cta-text">
        <h2>Unverbindlich anfragen</h2>
        <p>Erstgespräch kostenlos — 30 Minuten, und Sie wissen, wo Sie stehen.</p>
      </div>
      <a href="/termin" class="btn btn-primary">Termin vereinbaren</a>
    </div>
  </section>

</Layout>

<style>
  .page-hero {
    padding: 10rem 0 5rem;
  }

  .page-hero h1 {
    font-size: clamp(3rem, 6vw, 4.5rem);
    font-weight: 300;
    margin-bottom: 1.5rem;
  }

  .page-hero h1 em {
    font-style: italic;
    color: var(--gold);
  }

  .hero-sub {
    max-width: 600px;
    font-size: 1.05rem;
    line-height: 1.8;
  }

  /* Top cards */
  .top-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border);
  }

  .top-card {
    background: var(--bg-card);
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
  }

  .top-card--highlight {
    background: var(--bg-surface);
  }

  .top-card-label {
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.75rem;
  }

  .top-card-price {
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 300;
    color: var(--text);
    margin-bottom: 1rem;
    line-height: 1.1;
  }

  .top-card--highlight .top-card-price {
    color: var(--gold);
  }

  .top-card-unit {
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 300;
    color: var(--text-muted);
  }

  .top-card p {
    font-size: 0.875rem;
    line-height: 1.75;
    color: var(--text-muted);
    flex: 1;
  }

  /* Section sub */
  .section-sub {
    font-size: 0.95rem;
    color: var(--text-muted);
    max-width: 560px;
    line-height: 1.8;
    margin-top: 0.5rem;
  }

  /* Project table */
  .project-table {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 2.5rem;
  }

  .project-row {
    display: grid;
    grid-template-columns: 1fr 140px 160px;
    gap: 2rem;
    align-items: center;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border);
  }

  .project-row:first-child {
    border-top: 1px solid var(--border);
  }

  .project-row--header {
    padding: 0.75rem 0;
    border-top: none;
  }

  .project-row--header span {
    font-size: 0.62rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .project-name strong {
    display: block;
    font-size: 0.925rem;
    font-weight: 500;
    color: var(--text);
    margin-bottom: 0.25rem;
  }

  .project-name span {
    font-size: 0.8rem;
    color: var(--text-subtle);
  }

  .project-effort {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .project-price {
    font-size: 0.925rem;
    font-weight: 500;
    color: var(--text);
    text-align: right;
  }

  /* Workshops */
  .workshop-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border);
    margin-top: 2.5rem;
  }

  .workshop-card {
    background: var(--bg-card);
    padding: 2rem;
  }

  .workshop-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .workshop-head h3 {
    font-size: 1.1rem;
    font-weight: 400;
    color: var(--text);
    line-height: 1.3;
  }

  .workshop-price {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--gold);
    white-space: nowrap;
    padding-top: 0.15rem;
  }

  .workshop-meta {
    display: block;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-subtle);
    margin-bottom: 1rem;
  }

  .workshop-card p {
    font-size: 0.875rem;
    line-height: 1.75;
    color: var(--text-muted);
  }

  /* FAQ */
  .faq-layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 5rem;
    align-items: start;
  }

  .faq-sidebar {
    position: sticky;
    top: 100px;
  }

  .faq-sidebar h2 {
    font-size: 2.5rem;
    line-height: 1.1;
  }

  .faq-items {
    display: flex;
    flex-direction: column;
  }

  .faq-item {
    border-bottom: 1px solid var(--border);
  }

  .faq-item:first-child {
    border-top: 1px solid var(--border);
  }

  .faq-item summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem 0;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text);
    cursor: pointer;
    user-select: none;
    transition: color var(--transition);
  }

  .faq-item summary::-webkit-details-marker { display: none; }

  .faq-item summary::after {
    content: '+';
    font-size: 1.2rem;
    font-weight: 300;
    color: var(--gold);
    flex-shrink: 0;
    transition: transform 200ms ease;
  }

  .faq-item[open] summary::after {
    transform: rotate(45deg);
  }

  .faq-item summary:hover { color: var(--gold); }

  .faq-item p {
    font-size: 0.875rem;
    line-height: 1.8;
    color: var(--text-muted);
    padding-bottom: 1.5rem;
    max-width: 640px;
  }

  /* CTA */
  .cta-banner {
    background: var(--bg-card);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    margin-top: 2rem;
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 4rem;
    padding-bottom: 4rem;
    gap: 3rem;
  }

  .cta-text h2 { font-size: clamp(1.8rem, 3vw, 2.5rem); margin-bottom: 0.75rem; }
  .cta-text p { max-width: 480px; }

  @media (max-width: 900px) {
    .top-cards { grid-template-columns: 1fr; }
    .project-row { grid-template-columns: 1fr; gap: 0.25rem; }
    .project-row--header { display: none; }
    .project-price { text-align: left; color: var(--gold); }
    .workshop-grid { grid-template-columns: 1fr; }
    .faq-layout { grid-template-columns: 1fr; gap: 2rem; }
    .faq-sidebar { position: static; }
    .cta-inner { flex-direction: column; align-items: flex-start; }
  }
</style>
