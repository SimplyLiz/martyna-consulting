---
import Layout from '../layouts/Layout.astro';
import BookingWidget from '../components/BookingWidget.astro';

const agenda = [
  'Fortschritte und offene Punkte',
  'Überprüfung umgesetzter Maßnahmen',
  'Neue Anforderungen und Prioritäten',
  'Nächste Schritte festlegen',
];
---

<Layout title="Folgetermin buchen" ogTitle="Folgetermin buchen" description="Buchen Sie einen Folgetermin mit Martyna Kwiecien von Claritas AI Consulting — für bestehende Kunden.">

  <section class="page-hero">
    <div class="container">
      <span class="section-label">Für bestehende Kunden</span>
      <span class="gold-rule"></span>
      <h1>Folgetermin<br /><em>buchen</em></h1>
      <p class="hero-sub">
        Wählen Sie einen passenden Termin für unser nächstes Gespräch.
        Bitte schildern Sie kurz, welche Themen wir besprechen sollen.
      </p>
    </div>
  </section>

  <div class="divider"></div>

  <section class="section">
    <div class="container">
      <BookingWidget
        type="folgetermin"
        duration="60 Minuten"
        cost="Nach Vereinbarung"
        agenda={agenda}
      />

      <div class="back-hint">
        Noch kein Kunde? <a href="/termin">Kostenloses Erstgespräch buchen →</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  .page-hero {
    padding: 10rem 0 5rem;
  }

  .page-hero h1 {
    font-size: clamp(3rem, 6vw, 4.5rem);
    font-weight: 300;
    margin-bottom: 1.5rem;
  }

  .page-hero h1 em {
    font-style: italic;
    color: var(--gold);
  }

  .hero-sub {
    max-width: 560px;
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .back-hint {
    margin-top: 2.5rem;
    font-size: 0.85rem;
    color: var(--text-subtle);
  }

  .back-hint a {
    color: var(--gold);
    text-decoration: none;
    transition: opacity var(--transition);
  }

  .back-hint a:hover { opacity: 0.8; }

  @media (max-width: 900px) {
    .page-hero { padding: 8rem 0 3rem; }
  }
</style>
