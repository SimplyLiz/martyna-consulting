---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Termin buchen" description="Buchen Sie ein Erstgespräch mit Martyna Kwiecien von Claritas AI Consulting.">

  <section class="page-hero">
    <div class="container">
      <span class="section-label">Terminbuchung</span>
      <span class="gold-rule"></span>
      <h1>Erstgespräch<br /><em>vereinbaren</em></h1>
      <p class="hero-sub">
        30 Minuten, kostenlos und unverbindlich. Wählen Sie einen
        passenden Termin und wir besprechen Ihre Situation.
      </p>
    </div>
  </section>

  <div class="divider"></div>

  <section class="section">
    <div class="container booking-layout">

      <div class="booking-info">
        <div class="booking-detail">
          <svg class="detail-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
          <div>
            <span class="detail-label">Dauer</span>
            <span class="detail-value">30 Minuten</span>
          </div>
        </div>
        <div class="booking-detail">
          <svg class="detail-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
          <div>
            <span class="detail-label">Format</span>
            <span class="detail-value">Videocall (Link nach Buchung)</span>
          </div>
        </div>
        <div class="booking-detail">
          <svg class="detail-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
          <div>
            <span class="detail-label">Kosten</span>
            <span class="detail-value">Kostenlos</span>
          </div>
        </div>

        <div class="booking-agenda">
          <span class="agenda-label">Gesprächsthemen</span>
          <ul>
            <li>Ihr KI-Einsatz und Ihre Branche</li>
            <li>Erste Einschätzung Ihrer Risikoklasse</li>
            <li>Offene Fragen zu DSGVO / EU AI Act</li>
            <li>Wie eine Zusammenarbeit aussehen könnte</li>
          </ul>
        </div>
      </div>

      <div class="booking-widget">
        <div id="step-1" class="booking-step active">
          <h3>1. Datum wählen</h3>
          <div id="calendar" class="calendar-wrap"></div>
        </div>

        <div id="step-2" class="booking-step" style="display:none;">
          <h3>2. Uhrzeit wählen</h3>
          <div class="step-back">
            <button class="back-btn" id="back-to-date">← Datum ändern</button>
            <span id="selected-date-display" class="selected-date"></span>
          </div>
          <div id="slots-grid" class="slots-grid">
            <p class="loading-text">Verfügbare Zeiten werden geladen...</p>
          </div>
        </div>

        <div id="step-3" class="booking-step" style="display:none;">
          <h3>3. Ihre Daten</h3>
          <div class="step-back">
            <button class="back-btn" id="back-to-slots">← Uhrzeit ändern</button>
            <span id="selected-slot-display" class="selected-date"></span>
          </div>

          <form id="booking-form" class="booking-form" novalidate>
            <input type="hidden" id="booking-date" name="date" />
            <input type="hidden" id="booking-time" name="time" />

            <div class="form-group">
              <label for="b-name">Name *</label>
              <input type="text" id="b-name" name="name" placeholder="Vor- und Nachname" required />
            </div>
            <div class="form-group">
              <label for="b-email">E-Mail *</label>
              <input type="email" id="b-email" name="email" placeholder="ihre@email.de" required />
            </div>
            <div class="form-group">
              <label for="b-company">Unternehmen</label>
              <input type="text" id="b-company" name="company" placeholder="Optional" />
            </div>
            <div class="form-group">
              <label for="b-topic">Thema / Anliegen</label>
              <textarea id="b-topic" name="topic" placeholder="Kurze Beschreibung, damit ich mich vorbereiten kann..." style="min-height:90px;"></textarea>
            </div>
            <div class="form-group form-group--checkbox">
              <label class="checkbox-label">
                <input type="checkbox" name="privacy" required />
                <span>
                  Ich stimme der <a href="/datenschutz" target="_blank">Datenschutzerklärung</a>
                  zu. *
                </span>
              </label>
            </div>

            <div id="booking-feedback"></div>

            <button type="submit" class="btn btn-primary">
              <span id="book-btn-text">Termin bestätigen</span>
              <span id="book-btn-loading" style="display:none;">Wird gebucht...</span>
            </button>
          </form>
        </div>

        <div id="step-4" class="booking-step" style="display:none;">
          <div class="success-state">
            <span class="success-icon">✓</span>
            <h3>Termin bestätigt!</h3>
            <p id="success-message">Wir freuen uns auf das Gespräch und melden uns mit dem Einladungslink.</p>
            <a href="/" class="btn btn-outline" style="margin-top:1.5rem;">Zur Startseite</a>
          </div>
        </div>
      </div>

    </div>
  </section>

</Layout>

<style>
  .page-hero {
    padding: 10rem 0 5rem;
  }

  .page-hero h1 {
    font-size: clamp(3rem, 6vw, 4.5rem);
    font-weight: 300;
    margin-bottom: 1.5rem;
  }

  .page-hero h1 em {
    font-style: italic;
    color: var(--gold);
  }

  .hero-sub {
    max-width: 560px;
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .booking-layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 5rem;
    align-items: start;
  }

  /* Booking info */
  .booking-info {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid var(--border);
    border-radius: 2px;
    overflow: hidden;
  }

  .booking-detail {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .detail-icon {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    color: var(--gold);
    opacity: 0.8;
  }

  .detail-label {
    display: block;
    font-size: 0.62rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.2rem;
  }

  .detail-value {
    display: block;
    font-size: 0.9rem;
    color: var(--text);
    font-weight: 400;
  }

  .booking-agenda {
    padding: 1.5rem;
    background: var(--bg-surface);
  }

  .agenda-label {
    display: block;
    font-size: 0.62rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.75rem;
  }

  .booking-agenda ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .booking-agenda li {
    font-size: 0.82rem;
    color: var(--text-muted);
    padding-left: 1rem;
    position: relative;
  }

  .booking-agenda li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--text-subtle);
    font-size: 0.65rem;
  }

  /* Booking widget */
  .booking-widget {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 2px;
    padding: 2.5rem;
  }

  .booking-step h3 {
    font-size: 1.2rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .step-back {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .back-btn {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    font-size: 0.8rem;
    font-family: var(--font-body);
    padding: 0;
    transition: color var(--transition);
  }

  .back-btn:hover { color: var(--gold); }

  .selected-date {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--gold);
    letter-spacing: 0.05em;
  }

  /* Calendar — :global() because these are injected via innerHTML */
  :global(.calendar-wrap) { min-height: 300px; }

  :global(.calendar-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  :global(.cal-nav) {
    background: none;
    border: 1px solid var(--border);
    color: var(--text-muted);
    cursor: pointer;
    padding: 0.5rem 0.75rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    border-radius: 2px;
    transition: all var(--transition);
  }
  :global(.cal-nav:hover) { border-color: var(--gold); color: var(--gold); }

  :global(.cal-month-label) {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--text);
  }

  :global(.calendar-grid) {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
  }

  :global(.cal-weekday) {
    text-align: center;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-subtle);
    padding: 0.5rem 0;
  }

  :global(.cal-day) {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    border-radius: 2px;
    cursor: pointer;
    transition: all var(--transition);
    color: var(--text-muted);
    border: 1px solid transparent;
  }
  :global(.cal-day:not(.disabled):not(.empty):hover) {
    background: var(--bg-surface);
    border-color: var(--border);
    color: var(--text);
  }
  :global(.cal-day.available) { color: var(--text); }
  :global(.cal-day.available:hover) {
    background: var(--gold-dim);
    border-color: var(--gold);
    color: var(--gold);
  }
  :global(.cal-day.selected) {
    background: var(--gold);
    color: var(--bg);
    font-weight: 500;
  }
  :global(.cal-day.disabled) { color: var(--text-subtle); cursor: not-allowed; opacity: 0.4; }
  :global(.cal-day.empty) { cursor: default; }
  :global(.cal-day.today) { border-color: var(--gold); color: var(--gold); }

  /* Slots — also injected dynamically */
  :global(.slots-grid) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
  }
  :global(.slot-btn) {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    color: var(--text-muted);
    padding: 0.75rem;
    text-align: center;
    font-family: var(--font-body);
    font-size: 0.85rem;
    cursor: pointer;
    border-radius: 2px;
    transition: all var(--transition);
    width: 100%;
  }
  :global(.slot-btn:hover) { border-color: var(--gold); color: var(--gold); background: var(--gold-dim); }
  :global(.slot-btn.selected) { background: var(--gold); border-color: var(--gold); color: var(--bg); font-weight: 500; }
  :global(.loading-text) { grid-column: 1 / -1; font-size: 0.85rem; color: var(--text-subtle); font-style: italic; }
  :global(.no-slots) {
    grid-column: 1 / -1;
    font-size: 0.85rem;
    color: var(--text-subtle);
    padding: 1rem;
    text-align: center;
    border: 1px dashed var(--border);
    border-radius: 2px;
  }

  /* Booking form */
  .booking-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group--checkbox {
    flex-direction: row;
    align-items: flex-start;
  }

  .checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    cursor: pointer;
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .checkbox-label input[type="checkbox"] {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-top: 2px;
    accent-color: var(--gold);
    cursor: pointer;
  }

  /* Success state */
  .success-state {
    text-align: center;
    padding: 3rem 1rem;
  }

  .success-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 1px solid #2a5a3a;
    color: #6fcf97;
    font-size: 1.5rem;
    margin: 0 auto 1.5rem;
  }

  .success-state h3 {
    margin-bottom: 0.75rem;
  }

  .success-state p {
    font-size: 0.9rem;
    max-width: 380px;
    margin: 0 auto;
  }

  @media (max-width: 900px) {
    .booking-layout { grid-template-columns: 1fr; gap: 2.5rem; }
    .slots-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script>
  // ─── Calendar State ───────────────────────────────────────────────────────
  let currentYear = new Date().getFullYear();
  let currentMonth = new Date().getMonth();
  let selectedDate: string | null = null;
  let selectedTime: string | null = null;

  const WEEKDAYS = ['Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa', 'So'];
  const MONTHS = ['Januar','Februar','März','April','Mai','Juni','Juli','August','September','Oktober','November','Dezember'];

  function formatDate(y: number, m: number, d: number): string {
    return `${y}-${String(m + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
  }

  function formatDisplayDate(dateStr: string): string {
    const [y, m, d] = dateStr.split('-').map(Number);
    return `${d}. ${MONTHS[m - 1]} ${y}`;
  }

  async function renderCalendar() {
    const cal = document.getElementById('calendar')!;
    const today = new Date();
    today.setHours(0, 0, 0, 0);

    // Fetch availability for month
    let available: string[] = [];
    try {
      const res = await fetch(`/api/slots?year=${currentYear}&month=${currentMonth + 1}`);
      const data = await res.json();
      available = data.availableDates || [];
    } catch { }

    const firstDay = new Date(currentYear, currentMonth, 1);
    const lastDay = new Date(currentYear, currentMonth + 1, 0);

    // Monday-first offset
    let startOffset = firstDay.getDay() - 1;
    if (startOffset < 0) startOffset = 6;

    let html = `
      <div class="calendar-header">
        <button class="cal-nav" id="prev-month">‹</button>
        <span class="cal-month-label">${MONTHS[currentMonth]} ${currentYear}</span>
        <button class="cal-nav" id="next-month">›</button>
      </div>
      <div class="calendar-grid">
    `;

    WEEKDAYS.forEach(d => { html += `<div class="cal-weekday">${d}</div>`; });

    for (let i = 0; i < startOffset; i++) {
      html += `<div class="cal-day empty"></div>`;
    }

    for (let d = 1; d <= lastDay.getDate(); d++) {
      const dateStr = formatDate(currentYear, currentMonth, d);
      const cellDate = new Date(currentYear, currentMonth, d);
      const isPast = cellDate < today;
      const isAvailable = available.includes(dateStr);
      const isSelected = dateStr === selectedDate;
      const isToday = cellDate.getTime() === today.getTime();

      let cls = 'cal-day';
      if (isPast) cls += ' disabled';
      else if (isSelected) cls += ' available selected';
      else if (isAvailable) cls += ' available';
      else cls += ' disabled';
      if (isToday && !isPast) cls += ' today';

      html += `<div class="${cls}" data-date="${dateStr}">${d}</div>`;
    }

    html += '</div>';
    cal.innerHTML = html;

    document.getElementById('prev-month')!.addEventListener('click', () => {
      if (currentMonth === 0) { currentMonth = 11; currentYear--; }
      else currentMonth--;
      renderCalendar();
    });

    document.getElementById('next-month')!.addEventListener('click', () => {
      if (currentMonth === 11) { currentMonth = 0; currentYear++; }
      else currentMonth++;
      renderCalendar();
    });

    cal.querySelectorAll('.cal-day.available').forEach(el => {
      el.addEventListener('click', () => {
        const date = (el as HTMLElement).dataset.date!;
        selectedDate = date;
        renderCalendar();
        showStep2(date);
      });
    });
  }

  async function showStep2(date: string) {
    document.getElementById('step-1')!.style.display = 'none';
    const step2 = document.getElementById('step-2')!;
    step2.style.display = 'block';
    document.getElementById('selected-date-display')!.textContent = formatDisplayDate(date);

    const grid = document.getElementById('slots-grid')!;
    grid.innerHTML = '<p class="loading-text">Verfügbare Zeiten werden geladen...</p>';

    try {
      const res = await fetch(`/api/slots?date=${date}`);
      const data = await res.json();
      const slots: string[] = data.slots || [];

      if (slots.length === 0) {
        grid.innerHTML = '<div class="no-slots">Keine verfügbaren Zeiten an diesem Tag.<br/>Bitte wählen Sie ein anderes Datum.</div>';
        return;
      }

      grid.innerHTML = slots.map(t => `
        <button class="slot-btn ${t === selectedTime ? 'selected' : ''}" data-time="${t}">${t} Uhr</button>
      `).join('');

      grid.querySelectorAll('.slot-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          selectedTime = (btn as HTMLElement).dataset.time!;
          grid.querySelectorAll('.slot-btn').forEach(b => b.classList.remove('selected'));
          btn.classList.add('selected');
          setTimeout(() => showStep3(), 300);
        });
      });
    } catch {
      grid.innerHTML = '<div class="no-slots">Fehler beim Laden der Zeiten. Bitte versuchen Sie es erneut.</div>';
    }
  }

  function showStep3() {
    document.getElementById('step-2')!.style.display = 'none';
    const step3 = document.getElementById('step-3')!;
    step3.style.display = 'block';
    document.getElementById('selected-slot-display')!.textContent =
      `${formatDisplayDate(selectedDate!)} um ${selectedTime} Uhr`;
    (document.getElementById('booking-date') as HTMLInputElement).value = selectedDate!;
    (document.getElementById('booking-time') as HTMLInputElement).value = selectedTime!;
  }

  // Navigation
  document.getElementById('back-to-date')?.addEventListener('click', () => {
    document.getElementById('step-2')!.style.display = 'none';
    document.getElementById('step-1')!.style.display = 'block';
  });

  document.getElementById('back-to-slots')?.addEventListener('click', () => {
    document.getElementById('step-3')!.style.display = 'none';
    document.getElementById('step-2')!.style.display = 'block';
  });

  // Booking form
  document.getElementById('booking-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const feedback = document.getElementById('booking-feedback')!;
    const btnText = document.getElementById('book-btn-text')!;
    const btnLoading = document.getElementById('book-btn-loading')!;
    const btn = (e.target as HTMLFormElement).querySelector('button[type="submit"]') as HTMLButtonElement;

    const formData = new FormData(e.target as HTMLFormElement);
    const data = Object.fromEntries(formData.entries());

    if (!data.name || !data.email) {
      feedback.innerHTML = '<div class="msg-error" style="margin-bottom:1rem;">Bitte füllen Sie alle Pflichtfelder aus.</div>';
      return;
    }

    if (!data.privacy) {
      feedback.innerHTML = '<div class="msg-error" style="margin-bottom:1rem;">Bitte stimmen Sie der Datenschutzerklärung zu.</div>';
      return;
    }

    btnText.style.display = 'none';
    btnLoading.style.display = 'inline';
    btn.disabled = true;
    feedback.innerHTML = '';

    try {
      const res = await fetch('/api/book', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      const result = await res.json();

      if (res.ok) {
        document.getElementById('step-3')!.style.display = 'none';
        const step4 = document.getElementById('step-4')!;
        step4.style.display = 'block';
        document.getElementById('success-message')!.textContent =
          `Ihr Termin am ${formatDisplayDate(data.date as string)} um ${data.time} Uhr wurde bestätigt. Eine Bestätigungs-E-Mail geht in Kürze an ${data.email}.`;
      } else {
        feedback.innerHTML = `<div class="msg-error" style="margin-bottom:1rem;">${result.error || 'Buchung fehlgeschlagen. Bitte versuchen Sie es erneut.'}</div>`;
        btnText.style.display = 'inline';
        btnLoading.style.display = 'none';
        btn.disabled = false;
      }
    } catch {
      feedback.innerHTML = '<div class="msg-error" style="margin-bottom:1rem;">Fehler bei der Buchung. Bitte kontaktieren Sie uns direkt.</div>';
      btnText.style.display = 'inline';
      btnLoading.style.display = 'none';
      btn.disabled = false;
    }
  });

  // Init
  renderCalendar();
</script>
