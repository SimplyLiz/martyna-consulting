---
import Layout from '../../layouts/Layout.astro';
const token = Astro.url.searchParams.get('token') || '';
---
<Layout title="Newsletter bestätigen" ogTitle="Newsletter bestätigen">
  <section class="page-hero">
    <div class="container" style="max-width:640px;">
      <span class="section-label">Newsletter</span>
      <span class="gold-rule"></span>
      <h1 style="font-size: clamp(2.2rem, 4vw, 3rem); font-weight: 300; margin-bottom: 1.5rem;">
        Bestätigen · Confirm · Potwierdź
      </h1>
      <p style="color: var(--text-muted); margin-bottom: 2rem;">
        Klicken Sie auf den Button, um Ihre Newsletter-Anmeldung zu bestätigen.<br>
        Click the button to confirm your newsletter subscription.<br>
        Kliknij przycisk, aby potwierdzić subskrypcję newslettera.
      </p>
      <div id="feedback"></div>
      <button id="confirm-btn" class="btn btn-primary" {token ? '' : 'disabled'}>
        Bestätigen · Confirm · Potwierdź
      </button>
    </div>
  </section>
</Layout>

<script define:vars={{ token }}>
  const btn = document.getElementById('confirm-btn');
  const fb = document.getElementById('feedback');

  if (!token) {
    fb.innerHTML = '<div class="msg-error">Kein gültiger Token / Invalid token.</div>';
  }

  btn.addEventListener('click', async () => {
    btn.disabled = true;
    try {
      const res = await fetch('/api/newsletter/confirm', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token }),
      });
      const data = await res.json();
      if (res.ok) {
        fb.innerHTML = '<div class="msg-success">Anmeldung bestätigt. · Subscription confirmed. · Subskrypcja potwierdzona.</div>';
        btn.style.display = 'none';
      } else {
        fb.innerHTML = `<div class="msg-error">${data.error || 'Fehler'}</div>`;
        btn.disabled = false;
      }
    } catch {
      fb.innerHTML = '<div class="msg-error">Netzwerkfehler / Network error.</div>';
      btn.disabled = false;
    }
  });
</script>

<style>
  .page-hero { padding: 10rem 0 5rem; }
</style>
