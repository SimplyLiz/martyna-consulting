---
import Layout from '../layouts/Layout.astro';
import BookingWidget from '../components/BookingWidget.astro';

const agenda = [
  'Ihr KI-Einsatz und Ihre Branche',
  'Erste Einschätzung Ihrer Risikoklasse',
  'Offene Fragen zu DSGVO / EU AI Act',
  'Wie eine Zusammenarbeit aussehen könnte',
];
---

<Layout title="Termin buchen" ogTitle="Erstgespräch vereinbaren" description="Buchen Sie ein kostenloses Erstgespräch mit Martyna Kwiecien von Claritas AI Consulting — 30 Minuten, unverbindlich.">

  <section class="page-hero">
    <div class="container">
      <span class="section-label">Erstgespräch</span>
      <span class="gold-rule"></span>
      <h1>Termin<br /><em>vereinbaren</em></h1>
      <p class="hero-sub">
        30 Minuten, kostenlos und unverbindlich. Wählen Sie einen
        passenden Termin und wir besprechen Ihre Situation.
      </p>
    </div>
  </section>

  <div class="divider"></div>

  <section class="section">
    <div class="container">
      <BookingWidget
        type="erstgespraech"
        duration="30 Minuten"
        cost="Kostenlos"
        agenda={agenda}
      />

      <div class="followup-hint">
        Bereits Kunde? <a href="/termin">Folgetermin buchen →</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  .page-hero {
    padding: 10rem 0 5rem;
  }

  .page-hero h1 {
    font-size: clamp(3rem, 6vw, 4.5rem);
    font-weight: 300;
    margin-bottom: 1.5rem;
  }

  .page-hero h1 em {
    font-style: italic;
    color: var(--gold);
  }

  .hero-sub {
    max-width: 560px;
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .followup-hint {
    margin-top: 2.5rem;
    font-size: 0.85rem;
    color: var(--text-subtle);
  }

  .followup-hint a {
    color: var(--gold);
    text-decoration: none;
    transition: opacity var(--transition);
  }

  .followup-hint a:hover { opacity: 0.8; }

  @media (max-width: 900px) {
    .page-hero { padding: 8rem 0 3rem; }
  }
</style>
