---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Kontakt" description="Schreiben Sie uns – Claritas AI Consulting antwortet innerhalb von 24 Stunden.">

  <section class="page-hero">
    <div class="container">
      <span class="section-label">Kontakt</span>
      <span class="gold-rule"></span>
      <h1>Schreiben Sie uns</h1>
      <p class="hero-sub">
        Für Anfragen, Projektideen oder allgemeine Fragen. Wir antworten
        innerhalb von 24 Werktag-Stunden. Für ein Erstgespräch empfehlen
        wir die direkte <a href="/termin">Terminbuchung</a>.
      </p>
    </div>
  </section>

  <div class="divider"></div>

  <section class="section">
    <div class="container contact-layout">

      <div class="contact-info">
        <h3>Direktkontakt</h3>
        <div class="info-items">
          <div class="info-item">
            <span class="info-label">E-Mail</span>
            <a href="mailto:hallo@claritas-ai.consulting">hallo@claritas-ai.consulting</a>
          </div>
          <div class="info-item">
            <span class="info-label">LinkedIn</span>
            <a href="https://www.linkedin.com/in/martyna-paulina-kwiecien-9393961a3" target="_blank" rel="noopener">
              Martyna Kwiecien
            </a>
          </div>
          <div class="info-item">
            <span class="info-label">Erstgespräch</span>
            <a href="/termin">Online-Termin vereinbaren →</a>
          </div>
        </div>

        <div class="response-note">
          <span class="response-label">Antwortzeit</span>
          <p>
            Anfragen werden in der Regel innerhalb von 24 Stunden
            an Werktagen beantwortet.
          </p>
        </div>

        <div class="disclaimer-note notice" style="margin-top:2rem;">
          <strong>Kein Mandatsverhältnis:</strong> Durch die Kontaktaufnahme
          entsteht kein Beratungsvertrag. Claritas AI Consulting erbringt
          keine Rechtsberatung im Sinne der österreichischen Rechtsanwaltsordnung (RAO).
        </div>
      </div>

      <div class="contact-form-wrap">
        <form id="contact-form" class="contact-form" novalidate>
          <div class="form-row">
            <div class="form-group">
              <label for="name">Name *</label>
              <input type="text" id="name" name="name" placeholder="Vor- und Nachname" required />
            </div>
            <div class="form-group">
              <label for="company">Unternehmen</label>
              <input type="text" id="company" name="company" placeholder="Optional" />
            </div>
          </div>

          <div class="form-group">
            <label for="email">E-Mail-Adresse *</label>
            <input type="email" id="email" name="email" placeholder="ihre@email.de" required />
          </div>

          <div class="form-group">
            <label for="subject">Thema</label>
            <select id="subject" name="subject">
              <option value="">Bitte wählen...</option>
              <option value="eu-ai-act">EU AI Act Compliance</option>
              <option value="dsgvo">DSGVO / Datenschutz</option>
              <option value="governance">KI-Governance</option>
              <option value="schulung">Schulung / Workshop</option>
              <option value="sonstiges">Sonstiges</option>
            </select>
          </div>

          <div class="form-group">
            <label for="message">Nachricht *</label>
            <textarea id="message" name="message" placeholder="Beschreiben Sie kurz Ihr Anliegen..." required></textarea>
          </div>

          <div class="form-group form-group--checkbox">
            <label class="checkbox-label">
              <input type="checkbox" name="privacy" required />
              <span>
                Ich habe die <a href="/datenschutz" target="_blank">Datenschutzerklärung</a>
                gelesen und bin mit der Verarbeitung meiner Daten einverstanden. *
              </span>
            </label>
          </div>

          <div id="form-feedback"></div>

          <button type="submit" class="btn btn-primary submit-btn">
            <span id="btn-text">Nachricht senden</span>
            <span id="btn-loading" style="display:none;">Wird gesendet...</span>
          </button>
        </form>
      </div>

    </div>
  </section>

</Layout>

<style>
  .page-hero {
    padding: 10rem 0 5rem;
  }

  .page-hero h1 {
    font-size: clamp(3rem, 6vw, 4.5rem);
    font-weight: 300;
    margin-bottom: 1.5rem;
  }

  .hero-sub {
    max-width: 580px;
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .contact-layout {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 5rem;
    align-items: start;
  }

  .contact-info h3 {
    font-size: 1.2rem;
    margin-bottom: 1.75rem;
  }

  .info-items {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-bottom: 2rem;
  }

  .info-item {
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }

  .info-item:first-child { border-top: 1px solid var(--border); }

  .info-label {
    display: block;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-subtle);
    margin-bottom: 0.35rem;
  }

  .info-item a {
    font-size: 0.9rem;
    color: var(--text-muted);
    transition: color var(--transition);
  }

  .info-item a:hover { color: var(--gold); }

  .response-note {
    margin-top: 1.5rem;
  }

  .response-label {
    display: block;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.5rem;
  }

  .response-note p { font-size: 0.85rem; }

  /* Form */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-group--checkbox {
    flex-direction: row;
    align-items: flex-start;
  }

  .checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    cursor: pointer;
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .checkbox-label input[type="checkbox"] {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-top: 2px;
    accent-color: var(--gold);
    cursor: pointer;
  }

  .checkbox-label a { font-size: inherit; }

  .submit-btn {
    align-self: flex-start;
    padding: 0.9rem 2.5rem;
  }

  @media (max-width: 900px) {
    .contact-layout { grid-template-columns: 1fr; gap: 3rem; }
    .form-row { grid-template-columns: 1fr; }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const feedback = document.getElementById('form-feedback')!;
  const btnText = document.getElementById('btn-text')!;
  const btnLoading = document.getElementById('btn-loading')!;
  const submitBtn = form.querySelector('.submit-btn') as HTMLButtonElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    feedback.innerHTML = '';

    const data = Object.fromEntries(new FormData(form).entries());

    if (!data.name || !data.email || !data.message) {
      feedback.innerHTML = '<div class="msg-error">Bitte füllen Sie alle Pflichtfelder aus.</div>';
      return;
    }

    if (!data.privacy) {
      feedback.innerHTML = '<div class="msg-error">Bitte stimmen Sie der Datenschutzerklärung zu.</div>';
      return;
    }

    btnText.style.display = 'none';
    btnLoading.style.display = 'inline';
    submitBtn.disabled = true;

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      const result = await res.json();

      if (res.ok) {
        form.reset();
        feedback.innerHTML = '<div class="msg-success">Vielen Dank! Ihre Nachricht wurde gesendet. Wir melden uns innerhalb von 24 Stunden.</div>';
      } else {
        feedback.innerHTML = `<div class="msg-error">${result.error || 'Ein Fehler ist aufgetreten. Bitte versuchen Sie es erneut.'}</div>`;
      }
    } catch {
      feedback.innerHTML = '<div class="msg-error">Ein Fehler ist aufgetreten. Bitte senden Sie uns eine direkte E-Mail.</div>';
    } finally {
      btnText.style.display = 'inline';
      btnLoading.style.display = 'none';
      submitBtn.disabled = false;
    }
  });
</script>
