---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogTitle?: string;
}

const {
  title,
  description = 'Claritas AI Consulting – Regulatorisches Consulting zu EU AI Act, DSGVO und KI-Governance für Unternehmen.',
  ogTitle,
} = Astro.props;

const siteUrl = 'https://claritas-ai-consulting.vercel.app';
const resolvedOgTitle = ogTitle ?? title;
const ogImage = `${siteUrl}/api/og?title=${encodeURIComponent(resolvedOgTitle)}&description=${encodeURIComponent(description)}`;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Claritas AI Consulting',
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  description,
  founder: {
    '@type': 'Person',
    name: 'Martyna Kwiecien',
    jobTitle: 'Juristin, AI Compliance Consultant',
  },
  areaServed: ['DE', 'AT', 'EU'],
  knowsAbout: ['EU AI Act', 'DSGVO', 'KI-Governance', 'NIS2'],
  sameAs: ['https://www.linkedin.com/in/martyna-paulina-kwiecien-9393961a3'],
};
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title} | Claritas AI Consulting</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={`${resolvedOgTitle} | Claritas AI Consulting`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={resolvedOgTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={resolvedOgTitle} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <script>
      (function() {
        var path = window.location.pathname;
        if (path === '/admin' || path.startsWith('/admin/') || path === '/api') return;
        
        // Get or create visitor session ID
        var sid = sessionStorage.getItem('claritas_sid');
        if (!sid) {
          sid = 'v' + Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
          sessionStorage.setItem('claritas_sid', sid);
        }
        
        fetch('/api/track', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ path: path, referrer: document.referrer, sid: sid }),
        }).catch(function() {});
      })();
    </script>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
