---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="divider"></div>
  <div class="container footer-inner">
    <div class="footer-brand">
      <div class="logo-wrap">
        <span class="logo-mark">C</span>
        <div class="logo-text">
          <span class="logo-name">Claritas AI Consulting</span>
          <span class="logo-tagline">Klarheit im Regulierungsdickicht</span>
        </div>
      </div>
      <p class="footer-desc">
        Regulatorisches Consulting zu EU AI Act, DSGVO und KI-Governance —
        praxisnah, verständlich, unabhängig.
      </p>
      <p class="footer-disclaimer">
        Die Inhalte dieser Website stellen keine Rechtsberatung im Sinne der
        österreichischen Rechtsanwaltsordnung (RAO) dar. Claritas AI Consulting
        erbringt regulatorisches und compliance-orientiertes Consulting als
        Juristin — nicht als eingetragene Rechtsanwältin. Für anwaltliche
        Vertretung vermitteln wir gerne geeignete Kanzleien.
      </p>
    </div>

    <div class="footer-nav">
      <div class="footer-col">
        <span class="footer-col-title">Leistungen</span>
        <a href="/leistungen#eu-ai-act">EU AI Act</a>
        <a href="/leistungen#dsgvo">DSGVO &amp; Datenschutz</a>
        <a href="/leistungen#governance">KI-Governance</a>
        <a href="/leistungen#schulungen">Schulungen</a>
      </div>
      <div class="footer-col">
        <span class="footer-col-title">Unternehmen</span>
        <a href="/ueber-martyna">Über mich</a>
        <a href="/kontakt">Kontakt</a>
        <a href="/termin">Termin vereinbaren</a>
      </div>
      <div class="footer-col">
        <span class="footer-col-title">Rechtliches</span>
        <a href="/impressum">Impressum</a>
        <a href="/datenschutz">Datenschutz</a>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <span>&copy; {currentYear} Claritas AI Consulting. Alle Rechte vorbehalten.</span>
      <a href="https://www.linkedin.com/in/martyna-paulina-kwiecien-9393961a3" target="_blank" rel="noopener" class="linkedin-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
        LinkedIn
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 5rem;
    padding-top: 4rem;
    padding-bottom: 3rem;
  }

  .logo-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .logo-mark {
    width: 32px;
    height: 32px;
    border: 1px solid var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--gold);
    border-radius: 2px;
    flex-shrink: 0;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .logo-name {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
  }

  .logo-tagline {
    font-size: 0.6rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .footer-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
    line-height: 1.7;
  }

  .footer-disclaimer {
    font-size: 0.75rem;
    color: var(--text-subtle);
    line-height: 1.7;
    border-left: 2px solid var(--border);
    padding-left: 1rem;
  }

  .footer-nav {
    display: flex;
    gap: 3rem;
    align-items: flex-start;
    padding-top: 0.5rem;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-col-title {
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.25rem;
  }

  .footer-col a {
    font-size: 0.85rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition);
  }
  .footer-col a:hover { color: var(--text); }

  .footer-bottom {
    border-top: 1px solid var(--border);
    padding: 1.25rem 0;
  }

  .footer-bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .footer-bottom span {
    font-size: 0.75rem;
    color: var(--text-subtle);
  }

  .linkedin-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition);
  }
  .linkedin-link:hover { color: var(--gold); }

  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding-top: 2.5rem;
      padding-bottom: 2rem;
    }
    .footer-nav {
      flex-wrap: wrap;
      gap: 2rem;
    }
    .footer-bottom-inner {
      flex-direction: column;
      gap: 0.75rem;
      text-align: center;
    }
  }
</style>
