---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="divider"></div>

  <section class="newsletter-section">
    <div class="container newsletter-inner">
      <div class="newsletter-lead">
        <span class="footer-col-title">Newsletter</span>
        <h3 class="newsletter-title">Regulatorische Updates. Prägnant.</h3>
        <p class="newsletter-desc">
          EU AI Act, DSGVO, KI-Governance — kuratiert von Martyna Kwiecien.
          Keine Werbung. Jederzeit abbestellbar.
        </p>
      </div>
      <form id="newsletter-form" class="newsletter-form" novalidate>
        <div class="nl-row">
          <input type="email" name="email" id="nl-email" placeholder="ihre@email.de" required />
          <select name="language" id="nl-lang" aria-label="Sprache">
            <option value="de">Deutsch</option>
            <option value="en">English</option>
            <option value="pl">Polski</option>
          </select>
          <button type="submit" class="btn btn-primary nl-submit">Abonnieren</button>
        </div>
        <div id="nl-feedback" class="nl-feedback"></div>
      </form>
    </div>
  </section>

  <div class="divider"></div>

  <div class="container footer-inner">
    <div class="footer-brand">
      <div class="logo-wrap">
        <span class="logo-mark">C</span>
        <div class="logo-text">
          <span class="logo-name">Claritas AI Consulting</span>
          <span class="logo-tagline">Klarheit im Regulierungsdickicht</span>
        </div>
      </div>
      <p class="footer-desc">
        Regulatorisches Consulting zu EU AI Act, DSGVO und KI-Governance —
        praxisnah, verständlich, unabhängig.
      </p>
      <p class="footer-disclaimer">
        Die Inhalte dieser Website stellen keine Rechtsberatung im Sinne der
        österreichischen Rechtsanwaltsordnung (RAO) dar. Claritas AI Consulting
        erbringt regulatorisches und compliance-orientiertes Consulting als
        Juristin — nicht als eingetragene Rechtsanwältin. Für anwaltliche
        Vertretung vermitteln wir gerne geeignete Kanzleien.
      </p>
    </div>

    <div class="footer-nav">
      <div class="footer-col">
        <span class="footer-col-title">Leistungen</span>
        <a href="/leistungen#eu-ai-act">EU AI Act</a>
        <a href="/leistungen#dsgvo">DSGVO &amp; Datenschutz</a>
        <a href="/leistungen#governance">KI-Governance</a>
        <a href="/leistungen#schulungen">Schulungen</a>
      </div>
      <div class="footer-col">
        <span class="footer-col-title">Unternehmen</span>
        <a href="/ueber-martyna">Über mich</a>
        <a href="/kontakt">Kontakt</a>
        <a href="/termin">Termin vereinbaren</a>
      </div>
      <div class="footer-col">
        <span class="footer-col-title">Rechtliches</span>
        <a href="/impressum">Impressum</a>
        <a href="/datenschutz">Datenschutz</a>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <span>&copy; {currentYear} Claritas AI Consulting. Alle Rechte vorbehalten.</span>
      <a href="https://www.linkedin.com/in/martyna-paulina-kwiecien-9393961a3" target="_blank" rel="noopener" class="linkedin-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
        LinkedIn
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 5rem;
    padding-top: 4rem;
    padding-bottom: 3rem;
  }

  .logo-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .logo-mark {
    width: 32px;
    height: 32px;
    border: 1px solid var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--gold);
    border-radius: 2px;
    flex-shrink: 0;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .logo-name {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
  }

  .logo-tagline {
    font-size: 0.6rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .footer-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
    line-height: 1.7;
  }

  .footer-disclaimer {
    font-size: 0.75rem;
    color: var(--text-subtle);
    line-height: 1.7;
    border-left: 2px solid var(--border);
    padding-left: 1rem;
  }

  .footer-nav {
    display: flex;
    gap: 3rem;
    align-items: flex-start;
    padding-top: 0.5rem;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-col-title {
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.25rem;
  }

  .footer-col a {
    font-size: 0.85rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition);
  }
  .footer-col a:hover { color: var(--text); }

  .footer-bottom {
    border-top: 1px solid var(--border);
    padding: 1.25rem 0;
  }

  .footer-bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .footer-bottom span {
    font-size: 0.75rem;
    color: var(--text-subtle);
  }

  .linkedin-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition);
  }
  .linkedin-link:hover { color: var(--gold); }

  /* Newsletter */
  .newsletter-section {
    padding: 3rem 0;
  }
  .newsletter-inner {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .newsletter-title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 400;
    margin: 0.75rem 0 0.75rem;
    color: var(--text);
  }
  .newsletter-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 440px;
  }
  .newsletter-form { width: 100%; }
  .nl-row {
    display: grid;
    grid-template-columns: 1fr 130px auto;
    gap: 0.5rem;
  }
  .nl-row input[type="email"],
  .nl-row select {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 0.75rem 0.9rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    border-radius: 2px;
    outline: none;
    transition: border-color 200ms;
  }
  .nl-row input[type="email"]:focus,
  .nl-row select:focus { border-color: var(--gold); }
  .nl-submit {
    padding: 0.75rem 1.25rem;
    font-size: 0.78rem;
    white-space: nowrap;
  }
  .nl-feedback {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    min-height: 1em;
  }
  .nl-feedback.ok { color: #6fcf97; }
  .nl-feedback.err { color: #eb5757; }

  @media (max-width: 768px) {
    .newsletter-inner { grid-template-columns: 1fr; gap: 1.5rem; }
    .nl-row { grid-template-columns: 1fr; }
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding-top: 2.5rem;
      padding-bottom: 2rem;
    }
    .footer-nav {
      flex-wrap: wrap;
      gap: 2rem;
    }
    .footer-bottom-inner {
      flex-direction: column;
      gap: 0.75rem;
      text-align: center;
    }
  }
</style>

<script>
  const COPY: Record<string, { placeholder: string; button: string; ok: string; err: string; invalid: string }> = {
    de: {
      placeholder: 'ihre@email.de',
      button: 'Abonnieren',
      ok: 'Danke! Bitte prüfen Sie Ihr Postfach.',
      err: 'Etwas ist schiefgelaufen. Bitte erneut versuchen.',
      invalid: 'Bitte geben Sie eine gültige E-Mail ein.',
    },
    en: {
      placeholder: 'your@email.com',
      button: 'Subscribe',
      ok: 'Thanks! Please check your inbox.',
      err: 'Something went wrong. Please try again.',
      invalid: 'Please enter a valid email.',
    },
    pl: {
      placeholder: 'twoj@email.pl',
      button: 'Subskrybuj',
      ok: 'Dziękujemy! Sprawdź swoją skrzynkę.',
      err: 'Coś poszło nie tak. Spróbuj ponownie.',
      invalid: 'Podaj prawidłowy adres e-mail.',
    },
  };

  const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
  if (form) {
    const emailInput = document.getElementById('nl-email') as HTMLInputElement;
    const langSelect = document.getElementById('nl-lang') as HTMLSelectElement;
    const submitBtn = form.querySelector('.nl-submit') as HTMLButtonElement;
    const fb = document.getElementById('nl-feedback')!;

    const applyCopy = () => {
      const c = COPY[langSelect.value] || COPY.de;
      emailInput.placeholder = c.placeholder;
      submitBtn.textContent = c.button;
    };
    langSelect.addEventListener('change', applyCopy);
    applyCopy();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const c = COPY[langSelect.value] || COPY.de;
      fb.className = 'nl-feedback';
      const email = emailInput.value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        fb.textContent = c.invalid;
        fb.classList.add('err');
        return;
      }
      submitBtn.disabled = true;
      try {
        const res = await fetch('/api/newsletter/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, language: langSelect.value }),
        });
        if (res.ok) {
          fb.textContent = c.ok;
          fb.classList.add('ok');
          form.reset();
          applyCopy();
        } else {
          fb.textContent = c.err;
          fb.classList.add('err');
        }
      } catch {
        fb.textContent = c.err;
        fb.classList.add('err');
      } finally {
        submitBtn.disabled = false;
      }
    });
  }
</script>
